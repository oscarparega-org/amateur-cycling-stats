# Docker Compose (dev)
POSTGRES_USER=acs
POSTGRES_PASSWORD=acs_dev
POSTGRES_DB=acs_dev
POSTGRES_PORT=5432

# Backend authentication
FRONTEND_URL=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173
BETTER_AUTH_SECRET=change-me-to-a-random-secret-with-at-least-32-characters
# Public frontend origin. Auth callbacks enter through the Next.js BFF.
BETTER_AUTH_URL=http://localhost:5173
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# Optional idempotent administrator seed
ADMIN_USER=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
