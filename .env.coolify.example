# Reference only. scripts/coolify.mjs reconciles these values in Coolify.
# SERVICE_* values are generated by Coolify. Never commit their real values.

SERVICE_USER_POSTGRES=acs
SERVICE_PASSWORD_64_POSTGRES=replace-with-a-long-random-password
SERVICE_BASE64_64_AUTH=replace-with-a-random-secret-of-at-least-32-characters

FRONTEND_URL=https://dev.example.com
PUBLIC_API_URL=https://api-dev.example.com
TRUSTED_ORIGINS=https://dev.example.com

# Must match FRONTEND_URL; authentication callbacks enter through the frontend BFF.
BETTER_AUTH_URL=https://dev.example.com

# Configure these as repository-level GitHub Actions settings.
# RESEND_API_KEY and the Google credentials are secrets; EMAIL_FROM is a variable.
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Amateur Cycling Stats <noreply@example.com>

# Configure both values together when Google authentication is enabled.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
