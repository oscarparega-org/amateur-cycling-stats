# Configure these values in the Coolify development environment.
# Do not deploy this example file or commit real credentials.

POSTGRES_USER=acs_dev
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=acs_dev

FRONTEND_URL=https://dev.example.com
PUBLIC_API_URL=https://api-dev.example.com
TRUSTED_ORIGINS=https://dev.example.com

BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=https://api-dev.example.com

# Optional in local development; configure real values for email delivery.
RESEND_API_KEY=
EMAIL_FROM=Amateur Cycling Stats <noreply@example.com>

# Configure both values together when Google authentication is enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
